+        edit_boom(&mut h);
+        h.step(&json!({"choose_file":"skm-open.solidcraft"})).unwrap();
+        click(&mut h, "skm:open");
+        h.settle();
+        assert!(!h.app.skm_workspace.as_ref().unwrap().dirty);
