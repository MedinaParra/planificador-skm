+//! Actual SKM application frames: egui and the production viewport callbacks share one
+//! offscreen render pass. No compositing, replacement model image, or window host.
+//! Opt in with SKM_PREVIEW_DIR; unavailable GPU/failed rendering is a failure, not a skip.
+use std::{path::Path, time::Duration};
+
+use egui_wgpu::{RenderState, RendererOptions, ScreenDescriptor, WgpuConfiguration, wgpu};
+use serde_json::json;
+use solidcraft_ui_egui::{
+    gpu,
+    scenario::{self, Harness},
+};
+
+const WIDTH: u32 = 1600;
+const HEIGHT: u32 = 1000;
+
+fn frame(h: &mut Harness, rs: &RenderState, events: Vec<egui::Event>, save: Option<&Path>) {
+    let mut input = egui::RawInput {
+        screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(WIDTH as f32, HEIGHT as f32))),
+        time: Some(h.ctx.cumulative_frame_nr() as f64 / 60.0),
+        focused: true,
+        events,
+        ..Default::default()
+    };
+    h.app.raw_input_hook(&mut input);
+    let output = h.ctx.run_ui(input, |ui| {
+        h.app.logic(ui.ctx());
+        h.app.ui(ui);
+    });
+    h.output = output.platform_output.clone();
+    let jobs = h.ctx.tessellate(output.shapes, output.pixels_per_point);
+    assert!(jobs.iter().any(|p| matches!(p.primitive, egui::epaint::Primitive::Callback(_))), "real viewport callback absent");
+    let screen = ScreenDescriptor { size_in_pixels: [WIDTH, HEIGHT], pixels_per_point: output.pixels_per_point };
+    let size = wgpu::Extent3d { width: WIDTH, height: HEIGHT, depth_or_array_layers: 1 };
+    let texture = rs.device.create_texture(&wgpu::TextureDescriptor {
+        label: Some("SKM full application evidence"),
+        size,
+        mip_level_count: 1,
+        sample_count: 1,
+        dimension: wgpu::TextureDimension::D2,
+        format: rs.target_format,
+        usage: wgpu::TextureUsages::RENDER_ATTACHMENT | wgpu::TextureUsages::COPY_SRC,
+        view_formats: &[],
+    });
+    let view = texture.create_view(&Default::default());
+    let mut encoder = rs.device.create_command_encoder(&Default::default());
+    let mut renderer = rs.renderer.write();
+    for (id, deltas) in &output.textures_delta.set {
+        for delta in deltas {
+            renderer.update_texture(&rs.device, &rs.queue, *id, delta);
+        }
+    }
+    let mut submissions = renderer.update_buffers(&rs.device, &rs.queue, &mut encoder, &jobs, &screen);
+    {
+        let mut pass = encoder
+            .begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("SKM app + viewport"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &view,
+                    resolve_target: None,
+                    depth_slice: None,
+                    ops: wgpu::Operations { load: wgpu::LoadOp::Clear(wgpu::Color::WHITE), store: wgpu::StoreOp::Store },
+                })],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+                multiview_mask: None,
+            })
+            .forget_lifetime();
+        renderer.render(&mut pass, &jobs, &screen);
+    }
+    let row = WIDTH * 4;
+    let padded = row.div_ceil(wgpu::COPY_BYTES_PER_ROW_ALIGNMENT) * wgpu::COPY_BYTES_PER_ROW_ALIGNMENT;
+    let read = rs.device.create_buffer(&wgpu::BufferDescriptor {
+        label: Some("SKM evidence readback"),
+        size: u64::from(padded) * u64::from(HEIGHT),
+        usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST,
+        mapped_at_creation: false,
+    });
+    encoder.copy_texture_to_buffer(
+        texture.as_image_copy(),
+        wgpu::TexelCopyBufferInfo {
+            buffer: &read,
+            layout: wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(padded), rows_per_image: Some(HEIGHT) },
+        },
+        size,
+    );
+    submissions.push(encoder.finish());
+    let submission = rs.queue.submit(submissions);
+    for id in &output.textures_delta.free {
+        renderer.free_texture(id);
+    }
+    let stats = renderer.callback_resources.get::<gpu::Renderer>().expect("production viewport renderer installed").stats();
+    drop(renderer);
+    let slice = read.slice(..);
+    let (tx, rx) = std::sync::mpsc::channel();
+    slice.map_async(wgpu::MapMode::Read, move |result| {
+        let _ = tx.send(result);
+    });
+    rs.device.poll(wgpu::PollType::Wait { submission_index: Some(submission), timeout: Some(Duration::from_secs(60)) }).expect("GPU completion");
+    rx.recv_timeout(Duration::from_secs(5)).expect("readback callback").expect("readback mapping");
+    let stats = *stats.lock().expect("draw statistics");
+    assert!(stats.draw_calls > 0 && stats.triangles > 0, "viewport must draw actual geometry: {stats:?}");
+    if let Some(path) = save {
+        let data = slice.get_mapped_range().expect("mapped pixels");
+        let rgba: Vec<u8> = data.chunks(padded as usize).take(HEIGHT as usize).flat_map(|r| r[..row as usize].iter().copied()).collect();
+        image::RgbaImage::from_raw(WIDTH, HEIGHT, rgba).expect("complete image").save(path).expect("write evidence PNG");
+        eprintln!("SKM full native UI frame: {} — {stats:?}", path.display());
+    }
+}
+
+#[test]
+fn skm_full_application_gpu_preview() {
+    let Some(dir) = std::env::var_os("SKM_PREVIEW_DIR") else {
+        eprintln!("SKM_PREVIEW_DIR unset: explicit evidence capture not requested");
+        return;
+    };
+    let dir = std::path::PathBuf::from(dir);
+    std::fs::create_dir_all(&dir).expect("evidence directory");
+    if solidcraft_engine::geom::portable::enabled() {
+        solidcraft_engine::geom::portable::initialize(&std::env::current_exe().expect("test executable")).expect("portable test storage");
+    }
+    let config = WgpuConfiguration::default();
+    let instance = pollster::block_on(config.wgpu_setup.new_instance());
+    let rs = pollster::block_on(RenderState::create(
+        &config,
+        &instance,
+        None,
+        RendererOptions { msaa_samples: 1, depth_stencil_format: None, dithering: false, ..Default::default() },
+    ))
+    .expect("an offscreen GPU adapter is required for FULL application evidence");
+    assert_eq!(rs.target_format, wgpu::TextureFormat::Rgba8Unorm, "readback expects RGBA");
+    let mut h = Harness::new();
+    h.app.enable_skm_workspace();
+    assert_eq!(h.app.run("skm.scene.inspect", json!({})).expect("scene inspection")["exists"], true);
+    assert!(!h.app.session.world_state().bodies.is_empty(), "reference scene must contain real model bodies");
+    // Harness discards texture deltas. Start a new context, then render EVERY frame through
+    // the GPU so fonts and images are uploaded exactly as in the native host.
+    h.ctx = egui::Context::default();
+    h.ctx.enable_accesskit();
+    h.ctx.set_pixels_per_point(1.0);
+    solidcraft_ui_egui::fonts::setup_bundled_fonts(&h.ctx);
+    solidcraft_ui_egui::theme::apply(&h.ctx);
+    h.app.set_wgpu_split(&rs, 24, 8, 1);
+    for _ in 0..8 {
+        frame(&mut h, &rs, vec![], None);
+    }
+    h.app.fit_view();
+    let before = h.app.session.doc.to_json();
+    for (index, label) in ["obra", "grua", "carga", "maniobra", "verificaciones", "informe"].iter().enumerate() {
+        let at = scenario::handle_at(&format!("skm:area:{index}")).expect("SKM area button");
+        frame(&mut h, &rs, vec![egui::Event::PointerMoved(at)], None);
+        for pressed in [true, false] {
+            frame(
+                &mut h,
+                &rs,
+                vec![egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: egui::Modifiers::NONE }],
+                None,
+            );
+        }
+        for _ in 0..3 {
+            frame(&mut h, &rs, vec![], None);
+        }
+        let heading = ["Obra", "Grúa", "Carga y aparejos", "Maniobra", "Verificaciones", "Informe"][index];
+        assert!(h.widget(heading).is_some(), "selected area inspector heading must be visible: {heading}");
+        assert!(h.widget("NO OPERATIVO / NOT_VALIDATED").is_some(), "permanent safety banner");
+        assert!(scenario::handle_at("appbar:file").is_none(), "CAD app bar must not appear in SKM shell");
+        assert_eq!(h.app.session.doc.to_json(), before, "changing areas must not mutate the scene");
+        frame(&mut h, &rs, vec![], Some(&dir.join(format!("skm-{index}-{label}.png"))));
+    }
+    std::fs::write(
+        dir.join("capture.json"),
+        serde_json::to_vec_pretty(&json!({
+            "capture": "full application egui + production GPU viewport callbacks; single render target, no compositing",
+            "adapter": format!("{:?}", rs.adapter.get_info()), "width": WIDTH, "height": HEIGHT,
+            "operational_validation": false, "scene": "generic geometric reference, not OEM RT750"
+        }))
+        .expect("capture metadata"),
+    )
+    .expect("save capture metadata");
+}
