+//! Original procedural lifting reference, not an OEM crane or operational assessment.
+//! Own ordinary primitive features only: user geometry is never replaced by configuration.
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{Value, json};
+use solidcraft_doc::{Document, FeatureKind, Operation, appearance::Look};
+use solidcraft_geom::Vec3;
+
+use super::CommandSpec;
+use crate::{Result, Session, params::bad};
+
+const KEY: &str = "com.skm.reference_scene";
+const CMD: &str = "skm.scene";
+
+pub static COMMANDS: &[CommandSpec] = &[
+    CommandSpec::new("skm.scene.create", "Create reference lifting scene", create)
+        .params("Empty design only. Optional bounded geometric parameters in metres/degrees. Original generic geometry, NOT_VALIDATED, no OEM capacity."),
+    CommandSpec::new("skm.scene.configure", "Configure reference lifting geometry", configure)
+        .params("Partial parameters: boom_length_m, boom_angle_deg, slew_deg, hook_height_m, load_length_m, load_width_m, load_height_m, spreader_width_m, upper_sling_drop_m, lower_sling_drop_m. No capacity/rigging strength calculation."),
+    CommandSpec::new("skm.scene.inspect", "Inspect reference lifting scene", inspect).noundo().doc_only()
+        .params("Read-only parameters, geometric coordinates, saved steps and NOT_VALIDATED status."),
+    CommandSpec::new("skm.scene.capture", "Capture geometric reference step", capture).doc_only()
+        .params("name: unique 1..80 UTF-8 bytes; at most 32 steps. Parameters only, not an approved maneuver."),
+    CommandSpec::new("skm.scene.apply", "Apply geometric reference step", apply)
+        .params("name: saved geometric reference step. Preserves unrelated user geometry; refuses edited managed primitives."),
+];
+
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Parameters {
+    boom_length_m: f64,
+    boom_angle_deg: f64,
+    slew_deg: f64,
+    hook_height_m: f64,
+    load_length_m: f64,
+    load_width_m: f64,
+    load_height_m: f64,
+    spreader_width_m: f64,
+    upper_sling_drop_m: f64,
+    lower_sling_drop_m: f64,
+}
+impl Default for Parameters {
+    fn default() -> Self {
+        Self {
+            boom_length_m: 16.0,
+            boom_angle_deg: 55.0,
+            slew_deg: 25.0,
+            hook_height_m: 7.0,
+            load_length_m: 3.0,
+            load_width_m: 2.0,
+            load_height_m: 1.6,
+            spreader_width_m: 3.0,
+            upper_sling_drop_m: 1.0,
+            lower_sling_drop_m: 1.0,
+        }
+    }
+}
+impl Parameters {
+    fn tip(&self) -> Vec3 {
+        let a = self.boom_angle_deg.to_radians();
+        let s = self.slew_deg.to_radians();
+        Vec3::new(self.boom_length_m * a.cos() * s.cos(), self.boom_length_m * a.cos() * s.sin(), 2.2 + self.boom_length_m * a.sin())
+    }
+    fn validate(&self) -> Result<()> {
+        for (name, value, min, max) in [
+            ("boom_length_m", self.boom_length_m, 8.0, 30.0),
+            ("boom_angle_deg", self.boom_angle_deg, 15.0, 80.0),
+            ("slew_deg", self.slew_deg, -180.0, 180.0),
+            ("hook_height_m", self.hook_height_m, 2.0, 32.0),
+            ("load_length_m", self.load_length_m, 0.5, 6.0),
+            ("load_width_m", self.load_width_m, 0.5, 4.0),
+            ("load_height_m", self.load_height_m, 0.5, 4.0),
+            ("spreader_width_m", self.spreader_width_m, 0.5, 6.0),
+            ("upper_sling_drop_m", self.upper_sling_drop_m, 0.5, 3.0),
+            ("lower_sling_drop_m", self.lower_sling_drop_m, 0.5, 3.0),
+        ] {
+            if !value.is_finite() || value < min || value > max {
+                return Err(bad(CMD, format!("{name} must be finite in {min}..{max}")));
+            }
+        }
+        if self.hook_height_m > self.tip().z - 1.0 {
+            return Err(bad(CMD, "hook must remain at least 1 m below boom tip"));
+        }
+        if self.hook_height_m - self.upper_sling_drop_m - self.lower_sling_drop_m - self.load_height_m < 0.5 {
+            return Err(bad(CMD, "reference load must remain at least 0.5 m above ground; adjust hook/rigging/dimensions"));
+        }
+        Ok(())
+    }
+    fn merge(&self, patch: &Value) -> Result<Self> {
+        let fields = patch.as_object().ok_or_else(|| bad(CMD, "parameters must be an object"))?;
+        let mut value = serde_json::to_value(self).map_err(|e| bad(CMD, e.to_string()))?;
+        let target = value.as_object_mut().ok_or_else(|| bad(CMD, "invalid reference parameters"))?;
+        for (key, v) in fields {
+            if !target.contains_key(key) {
+                return Err(bad(CMD, format!("unknown parameter {key}")));
+            }
+            target.insert(key.clone(), v.clone());
+        }
+        let p: Self = serde_json::from_value(value).map_err(|e| bad(CMD, e.to_string()))?;
+        p.validate()?;
+        Ok(p)
+    }
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Step {
+    name: String,
+    parameters: Parameters,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Scene {
+    schema: u32,
+    parameters: Parameters,
+    features: Vec<u64>,
+    steps: Vec<Step>,
+}
+struct Part {
+    name: String,
+    kind: FeatureKind,
+    color: [u8; 3],
+}
+fn point(v: Vec3) -> [solidcraft_doc::expr::Expr; 3] {
+    [v.x, v.y, v.z].map(|x| format!("{} mm", x * 1000.0).into())
+}
+fn mm(v: f64) -> solidcraft_doc::expr::Expr {
+    format!("{} mm", v * 1000.0).into()
+}
+fn box_part(parts: &mut Vec<Part>, name: &str, center: Vec3, size: Vec3, color: [u8; 3]) {
+    parts.push(Part {
+        name: format!("SKM {name}"),
+        color,
+        kind: FeatureKind::Box {
+            corner: point(center - size * 0.5),
+            length: mm(size.x),
+            width: mm(size.y),
+            height: mm(size.z),
+            operation: Operation::NewBody,
+        },
+    });
+}
+fn rod(parts: &mut Vec<Part>, name: &str, from: Vec3, to: Vec3, radius: f64, color: [u8; 3]) {
+    let delta = to - from;
+    let height = delta.len();
+    let axis = delta.normalized().unwrap_or(Vec3::Z);
+    parts.push(Part {
+        name: format!("SKM {name}"),
+        color,
+        kind: FeatureKind::Cylinder { base: point(from), axis: axis.into(), radius: mm(radius), height: mm(height), operation: Operation::NewBody },
+    });
+}
+fn recipe(p: &Parameters) -> Vec<Part> {
+    let mut parts = Vec::new();
+    let yellow = [235, 176, 43];
+    let dark = [45, 55, 67];
+    let steel = [177, 190, 205];
+    let cyan = [38, 163, 181];
+    box_part(&mut parts, "Chasis referencial", Vec3::new(0.0, 0.0, 1.0), Vec3::new(6.5, 2.5, 0.65), yellow);
+    box_part(&mut parts, "Cabina", Vec3::new(-2.2, 0.0, 1.9), Vec3::new(1.7, 2.3, 1.3), yellow);
+    box_part(&mut parts, "Ventana cabina", Vec3::new(-3.06, 0.0, 2.1), Vec3::new(0.04, 1.95, 0.65), [73, 136, 164]);
+    box_part(&mut parts, "Torreta", Vec3::new(0.0, 0.0, 1.7), Vec3::new(2.0, 2.0, 0.75), yellow);
+    for (i, x) in [-2.2, 2.2].into_iter().enumerate() {
+        for (j, side) in [-1.0, 1.0].into_iter().enumerate() {
+            rod(&mut parts, &format!("Rueda {i}-{j}"), Vec3::new(x, side * 1.1, 0.6), Vec3::new(x, side * 1.5, 0.6), 0.6, dark);
+            box_part(&mut parts, &format!("Estabilizador {i}-{j}"), Vec3::new(x, side * 2.2, 0.85), Vec3::new(0.3, 2.4, 0.3), yellow);
+            rod(&mut parts, &format!("Pata {i}-{j}"), Vec3::new(x, side * 3.3, 0.12), Vec3::new(x, side * 3.3, 0.85), 0.16, steel);
+            box_part(&mut parts, &format!("Placa apoyo {i}-{j}"), Vec3::new(x, side * 3.3, 0.08), Vec3::new(0.85, 0.85, 0.16), dark);
+        }
+    }
+    let pivot = Vec3::new(0.0, 0.0, 2.2);
+    let tip = p.tip();
+    let direction = tip - pivot;
+    // Three overlapping telescopic reference sections. No OEM kinematics are claimed.
+    for (i, radius) in [0.40, 0.31, 0.23].into_iter().enumerate() {
+        let start = i as f64 / 3.0;
+        let end = ((i + 1) as f64 / 3.0 + 0.04).min(1.0);
+        rod(&mut parts, &format!("Pluma tramo {}", i + 1), pivot + direction * start, pivot + direction * end, radius, yellow);
+    }
+    let hook = Vec3::new(tip.x, tip.y, p.hook_height_m);
+    rod(&mut parts, "Cable izaje", tip, hook + Vec3::new(0.0, 0.0, 0.35), 0.035, steel);
+    box_part(&mut parts, "Bloque gancho", hook + Vec3::new(0.0, 0.0, 0.15), Vec3::new(0.5, 0.3, 0.4), dark);
+    let spread_z = hook.z - p.upper_sling_drop_m;
+    let left = Vec3::new(hook.x, hook.y - p.spreader_width_m / 2.0, spread_z);
+    let right = Vec3::new(hook.x, hook.y + p.spreader_width_m / 2.0, spread_z);
+    rod(&mut parts, "Eslinga superior A", hook, left, 0.045, [218, 104, 56]);
+    rod(&mut parts, "Eslinga superior B", hook, right, 0.045, [218, 104, 56]);
+    box_part(&mut parts, "Separador", Vec3::new(hook.x, hook.y, spread_z), Vec3::new(0.28, p.spreader_width_m + 0.3, 0.25), yellow);
+    let top = spread_z - p.lower_sling_drop_m;
+    for (i, x) in [-1.0, 1.0].into_iter().enumerate() {
+        for (j, y) in [-1.0, 1.0].into_iter().enumerate() {
