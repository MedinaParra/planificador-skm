+#[cfg(test)]
+mod interaction_tests {
+    use super::*;
+    use crate::scenario::Harness;
+
+    fn click(h: &mut Harness, handle: &str) {
+        let p = crate::scenario::handle_at(handle).expect("visible SKM control");
+        let result = h.call("ui.click", json!({"x":p.x,"y":p.y}));
+        assert_eq!(result["ok"], true, "{result}");
+    }
+    fn inspect(h: &mut Harness) -> Value {
+        h.app.run("skm.scene.inspect", json!({})).unwrap()
+    }
+    fn setup() -> Harness {
+        initialize_portable_test_storage();
+        let mut h = Harness::new();
+        h.app.enable_skm_workspace();
+        h.frames(3);
+        h
+    }
+    fn edit_boom(h: &mut Harness) {
+        click(h, "skm:area:1");
+        let p = crate::scenario::handle_at("skm:parameter:0").unwrap();
+        h.call("ui.drag", json!({"x0":p.x,"y0":p.y,"x1":p.x+40.0,"y1":p.y,"steps":8}));
+        assert!(h.app.skm_workspace.as_ref().unwrap().dirty);
+    }
+
+    #[test]
+    fn parameter_controls_apply_actual_geometry_and_steps_restore_it() {
+        let mut h = setup();
+        let original = inspect(&mut h);
+        click(&mut h, "skm:area:3");
+        click(&mut h, "skm:step_name");
+        h.call("ui.text", json!({"text":"Inicio"}));
+        click(&mut h, "skm:capture");
+        assert_eq!(inspect(&mut h)["steps"][0]["name"], "Inicio");
+        edit_boom(&mut h);
+        assert_eq!(inspect(&mut h)["boom_tip_m"], original["boom_tip_m"], "draft is not applied geometry");
+        click(&mut h, "skm:apply");
+        assert!(!h.app.skm_workspace.as_ref().unwrap().dirty);
+        assert_ne!(inspect(&mut h)["boom_tip_m"], original["boom_tip_m"]);
+        click(&mut h, "skm:area:3");
+        click(&mut h, "skm:step:0");
+        assert_eq!(inspect(&mut h)["parameters"], original["parameters"]);
+        assert_eq!(inspect(&mut h)["operational_approval"], false);
+    }
+
+    #[test]
+    fn dirty_draft_blocks_capture_and_step_application() {
+        let mut h = setup();
+        h.app.run("skm.scene.capture", json!({"name":"Inicio"})).unwrap();
+        edit_boom(&mut h);
+        click(&mut h, "skm:area:3");
+        click(&mut h, "skm:step_name");
+        h.call("ui.text", json!({"text":"Borrador"}));
+        click(&mut h, "skm:capture");
+        click(&mut h, "skm:step:0");
+        assert!(h.app.skm_workspace.as_ref().unwrap().dirty);
+        assert_eq!(inspect(&mut h)["steps"].as_array().unwrap().len(), 1);
+    }
+
+    #[test]
+    fn document_switch_and_async_adoption_drop_foreign_drafts() {
+        let mut h = setup();
+        edit_boom(&mut h);
+        crate::documents::open_tab(&mut h.app, solidcraft_engine::Session::default()).unwrap();
+        assert!(!h.app.skm_workspace.as_ref().unwrap().dirty);
+        // Exercise the same adoption path called by file_load::tick.
+        h.app.skm_workspace.as_mut().unwrap().dirty = true;
+        h.app.skm_workspace.as_mut().unwrap().step_name = "Foreign draft".into();
+        crate::documents::adopt(&mut h.app, solidcraft_engine::Session::default());
+        assert!(!h.app.skm_workspace.as_ref().unwrap().dirty);
+        assert!(h.app.skm_workspace.as_ref().unwrap().step_name.is_empty());
+        crate::documents::switch(&mut h.app, 0);
+        h.frames(3);
+        assert_eq!(inspect(&mut h)["parameters"]["boom_length_m"], 16.0);
+    }
+    #[test]
+    fn open_control_loads_saved_scene_without_foreign_draft() {
