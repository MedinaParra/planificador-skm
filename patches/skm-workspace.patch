+#[cfg(test)]
+fn initialize_portable_test_storage() {
+    if !solidcraft_engine::geom::portable::enabled() {
+        return;
+    }
+    static INIT: std::sync::OnceLock<Result<(), String>> = std::sync::OnceLock::new();
+    let result = INIT.get_or_init(|| {
+        let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+        solidcraft_engine::geom::portable::initialize(&exe).map_err(|e| e.to_string())
+    });
+    assert!(result.is_ok(), "portable test storage: {result:?}");
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn shell_is_opt_in_and_keeps_safety_warning() {
+        initialize_portable_test_storage();
+        let mut h = crate::scenario::Harness::new();
+        assert!(h.app.skm_workspace.is_none());
+        h.app.enable_skm_workspace();
+        h.frames(3);
+        assert!(h.app.skm_workspace.is_some());
+        assert!(h.widget("NO OPERATIVO / NOT_VALIDATED").is_some());
+        assert!(crate::scenario::handle_at("skm:part:4").is_some());
+        assert!(crate::scenario::handle_at("appbar:file").is_none());
+        assert!(h.app.run("skm.scene.inspect", json!({})).unwrap()["exists"].as_bool().unwrap());
+    }
+}
