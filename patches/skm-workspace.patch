+fn settled(s: &Session) -> Result<()> {
+    if s.read_only || s.active_sketch.is_some() || !s.pending_moves.is_empty() || s.doc.marker.is_some() {
+        return Err(bad(CMD, "finish edits/pending moves; reference scene requires writable design at timeline end"));
+    }
+    Ok(())
+}
+fn read(s: &Session) -> Result<Option<Scene>> {
+    let Some(value) = s.doc.metadata.get(KEY) else { return Ok(None) };
+    let scene: Scene = serde_json::from_value(value.clone()).map_err(|e| bad(CMD, e.to_string()))?;
+    if scene.schema != 1 || scene.steps.len() > 32 || scene.features.len() > 64 {
+        return Err(bad(CMD, "unsupported or oversized reference scene"));
+    }
+    scene.parameters.validate()?;
+    let mut names = BTreeSet::new();
+    for step in &scene.steps {
+        validate_name(&step.name)?;
+        step.parameters.validate()?;
+        if !names.insert(&step.name) {
+            return Err(bad(CMD, "duplicate reference step"));
+        }
+    }
+    Ok(Some(scene))
+}
+fn store(doc: &mut Document, scene: &Scene) -> Result<()> {
+    doc.metadata.set(KEY, serde_json::to_value(scene).map_err(|e| bad(CMD, e.to_string()))?)?;
+    Ok(())
+}
+fn describe(scene: &Scene) -> Value {
+    let tip = scene.parameters.tip();
+    json!({"exists":true,"parameters":scene.parameters,"steps":scene.steps,"validation_status":"NOT_VALIDATED",
+        "operational_approval":false,"reference_only":true,"oem_model":null,"capacity":null,
+        "load_mass_kg":null,"rigging_wll_kg":null,"mass_source":"NOT_SUPPLIED","managed_geometry_matches_parameters":true,
+        "boom_tip_m":[tip.x,tip.y,tip.z],"hook_position_m":[tip.x,tip.y,scene.parameters.hook_height_m],
+        "working_radius_m":tip.x.hypot(tip.y),"managed_feature_count":scene.features.len(),
+        "limits":"Geometry only: no OEM articulation, capacity, sling strength, stability, wind, ground bearing or swept-path approval."})
+}
+fn inspect(s: &mut Session, _: &Value) -> Result<Value> {
+    let Some(scene) = read(s)? else {
+        return Ok(
+            json!({"exists":false,"parameters":Parameters::default(),"steps":[],"validation_status":"NOT_VALIDATED","operational_approval":false}),
+        );
+    };
+    let mut value = describe(&scene);
+    let matches = validate_owned(s, &scene).is_ok();
+    value["managed_geometry_matches_parameters"] = json!(matches);
+    if !matches {
+        value["geometry_warning"] =
+            json!("Managed geometry is edited, dependent, rolled back or has pending moves; stored parameters cannot certify current geometry.");
+        for field in ["boom_tip_m", "hook_position_m", "working_radius_m"] {
+            value[field] = Value::Null;
+        }
+    }
+    Ok(value)
+}
+fn create(s: &mut Session, p: &Value) -> Result<Value> {
+    settled(s)?;
+    if read(s)?.is_some() || !s.doc.features.is_empty() || !s.doc.components.is_empty() || !s.doc.occurrences.is_empty() {
+        return Err(bad(CMD, "create only in a new empty design; existing user geometry is preserved"));
+    }
+    let parameters = Parameters::default().merge(p)?;
+    let mut doc = (*s.doc).clone();
+    let mut features = Vec::new();
+    for part in recipe(&parameters) {
+        let id = doc.add_feature(part.kind, Some(&part.name))?;
+        let feature = doc.feature_mut(id).ok_or_else(|| bad(CMD, "new primitive missing"))?;
+        feature.body_names = vec![part.name.clone()];
+        doc.appearances.bodies.insert(part.name, Look::custom(part.color, 1.0));
+        features.push(id);
+    }
+    let scene = Scene { schema: 1, parameters, features, steps: Vec::new() };
+    store(&mut doc, &scene)?;
+    s.doc = Arc::new(doc);
+    Ok(describe(&scene))
+}
+fn validate_owned(s: &Session, scene: &Scene) -> Result<()> {
+    if s.doc.marker.is_some() || !s.pending_moves.is_empty() {
+        return Err(bad(CMD, "reference geometry requires the timeline end and no pending component moves"));
+    }
+    let old = recipe(&scene.parameters);
+    let unique: BTreeSet<_> = scene.features.iter().copied().collect();
+    if old.len() != scene.features.len() || unique.len() != old.len() {
+        return Err(bad(CMD, "reference primitive inventory differs; no geometry changed"));
+    }
+    // Validate every owned primitive before touching any. Unrelated features are kept verbatim.
+    for (id, part) in scene.features.iter().zip(&old) {
+        let f = s.doc.feature(*id).ok_or_else(|| bad(CMD, "reference primitive missing; no geometry changed"))?;
+        if f.kind != part.kind || f.name != part.name || f.body_names != [part.name.clone()] || f.component != 0 || f.suppressed {
+            return Err(bad(CMD, "reference primitive was edited outside this configurator; no geometry changed"));
+        }
+    }
+    // A later operation can move/remove/cut a body without editing its original
+    // primitive. Walk the engine's typed references, rather than searching JSON text.
+    // Refuse the first dependent operation: this also closes every transitive chain.
+    let body_remap: BTreeMap<_, _> = old.iter().map(|part| (part.name.clone(), format!("__skm_dependency_probe__{}", part.name))).collect();
+    for f in &s.doc.features {
+        if unique.contains(&f.id) || f.suppressed {
+            continue;
+        }
+        let mut probe = f.kind.clone();
+        probe.remap_bodies(&body_remap);
+        let references_owned = probe != f.kind || old.iter().any(|part| f.kind.names_feature(&part.name));
+        let shadows_owned = f.body_names.iter().any(|name| body_remap.contains_key(name));
+        if references_owned || shadows_owned || (f.component == 0 && unscoped_geometry_operation(&f.kind)) {
+            return Err(bad(CMD, "downstream geometry may alter the reference scene; no geometry changed"));
+        }
+    }
+    Ok(())
+}
+
+// Empty boolean targets mean all bodies. Unscoped face/edge picks likewise cannot
+// certify the managed geometry from its primitive recipe. Explicit unrelated bodies
+// and independent NewBody primitives remain valid; no user feature is removed.
+fn unscoped_geometry_operation(kind: &FeatureKind) -> bool {
+    match kind {
+        FeatureKind::Box { operation, .. }
+        | FeatureKind::Cylinder { operation, .. }
+        | FeatureKind::Sphere { operation, .. }
+        | FeatureKind::Torus { operation, .. }
+        | FeatureKind::BoundaryFill { operation, .. } => *operation != Operation::NewBody,
+        FeatureKind::Extrude { operation, targets, .. }
+        | FeatureKind::Revolve { operation, targets, .. }
+        | FeatureKind::Loft { operation, targets, .. }
+        | FeatureKind::Sweep { operation, targets, .. }
+        | FeatureKind::Pipe { operation, targets, .. }
+        | FeatureKind::Coil { operation, targets, .. }
+        | FeatureKind::Thicken { operation, targets, .. } => *operation != Operation::NewBody && targets.is_empty(),
+        FeatureKind::Fillet { body, .. }
+        | FeatureKind::Chamfer { body, .. }
+        | FeatureKind::SheetFlange { body, .. }
+        | FeatureKind::SheetHem { body, .. }
+        | FeatureKind::SheetPerforate { body, .. }
+        | FeatureKind::SheetFold { body, .. }
+        | FeatureKind::SheetPath { body, .. }
+        | FeatureKind::SheetUnfold { body, .. }
+        | FeatureKind::Lip { body, .. } => body.is_none(),
+        FeatureKind::Emboss { targets, .. } => targets.is_empty(),
+        FeatureKind::Rib { .. } => true,
+        _ => !kind.face_points().is_empty() && kind.face_body().is_none(),
+    }
+}
+fn replace_parameters(s: &mut Session, mut scene: Scene, parameters: Parameters) -> Result<Value> {
+    settled(s)?;
+    parameters.validate()?;
+    validate_owned(s, &scene)?;
+    if parameters == scene.parameters {
+        return Ok(describe(&scene));
+    }
+    let new = recipe(&parameters);
+    let mut doc = (*s.doc).clone();
+    for (id, part) in scene.features.iter().zip(new) {
+        doc.feature_mut(*id).ok_or_else(|| bad(CMD, "reference primitive missing"))?.kind = part.kind;
+    }
+    scene.parameters = parameters;
+    store(&mut doc, &scene)?;
+    s.doc = Arc::new(doc);
+    Ok(describe(&scene))
+}
+fn configure(s: &mut Session, p: &Value) -> Result<Value> {
+    let scene = read(s)?.ok_or_else(|| bad(CMD, "create a reference scene first"))?;
+    let parameters = scene.parameters.merge(p)?;
+    replace_parameters(s, scene, parameters)
+}
+fn validate_name(name: &str) -> Result<()> {
+    if name.trim().is_empty() || name.len() > 80 {
+        return Err(bad(CMD, "step name must have 1..80 UTF-8 bytes"));
+    }
+    Ok(())
+}
+fn step_name(p: &Value) -> Result<&str> {
+    let object = p.as_object().ok_or_else(|| bad(CMD, "step requires an object"))?;
+    if object.len() != 1 {
+        return Err(bad(CMD, "step accepts name only"));
+    }
+    let name = p.get("name").and_then(Value::as_str).ok_or_else(|| bad(CMD, "step name required"))?.trim();
+    validate_name(name)?;
+    Ok(name)
+}
+fn capture(s: &mut Session, p: &Value) -> Result<Value> {
+    settled(s)?;
+    let name = step_name(p)?;
+    let mut scene = read(s)?.ok_or_else(|| bad(CMD, "create a reference scene first"))?;
+    validate_owned(s, &scene)?;
+    if scene.steps.len() >= 32 || scene.steps.iter().any(|step| step.name == name) {
+        return Err(bad(CMD, "step limit reached or duplicate name"));
+    }
+    scene.steps.push(Step { name: name.into(), parameters: scene.parameters.clone() });
+    let mut doc = (*s.doc).clone();
+    store(&mut doc, &scene)?;
+    s.doc = Arc::new(doc);
+    Ok(describe(&scene))
+}
+fn apply(s: &mut Session, p: &Value) -> Result<Value> {
+    let name = step_name(p)?;
+    let scene = read(s)?.ok_or_else(|| bad(CMD, "create a reference scene first"))?;
+    let parameters = scene.steps.iter().find(|step| step.name == name).ok_or_else(|| bad(CMD, "unknown reference step"))?.parameters.clone();
+    replace_parameters(s, scene, parameters)
+}
