+//! Dedicated, original SKM geometric planning shell. The native engine and viewport remain shared.
+//! No OEM capacity, rigging certification or operational approval is inferred from this scene.
+use crate::{
+    SolveApp,
+    theme::Tokens,
+    ui_kit::{Container, Edge, Surface},
+};
+use egui::{RichText, Ui};
+use serde_json::{Value, json};
+
+const AREAS: [&str; 6] = [
+    "skm.workspace.text_000",
+    "skm.workspace.text_001",
+    "skm.workspace.text_002",
+    "skm.workspace.text_003",
+    "skm.workspace.text_004",
+    "skm.workspace.text_005",
+];
+const PARTS: [&str; 5] =
+    ["skm.workspace.text_006", "skm.workspace.text_007", "skm.workspace.text_008", "skm.workspace.text_009", "skm.workspace.text_010"];
+const PARAMS: [(&str, &str, f64, f64, f64); 10] = [
+    ("boom_length_m", "skm.workspace.text_011", 16.0, 8.0, 30.0),
+    ("boom_angle_deg", "skm.workspace.text_012", 55.0, 15.0, 80.0),
+    ("slew_deg", "skm.workspace.text_013", 25.0, -180.0, 180.0),
+    ("hook_height_m", "skm.workspace.text_014", 7.0, 2.0, 32.0),
+    ("spreader_width_m", "skm.workspace.text_015", 3.0, 0.5, 6.0),
+    ("upper_sling_drop_m", "skm.workspace.text_016", 1.0, 0.5, 3.0),
+    ("lower_sling_drop_m", "skm.workspace.text_017", 1.0, 0.5, 3.0),
+    ("load_length_m", "skm.workspace.text_018", 3.0, 0.5, 6.0),
+    ("load_width_m", "skm.workspace.text_019", 2.0, 0.5, 4.0),
+    ("load_height_m", "skm.workspace.text_020", 1.6, 0.5, 4.0),
+];
+
+#[derive(Clone)]
+pub(crate) struct State {
+    area: usize,
+    part: usize,
+    values: [f64; 10],
+    dirty: bool,
+    inspection: Value,
+    error: Option<String>,
+    step_name: String,
+}
+impl Default for State {
+    fn default() -> Self {
+        Self { area: 0, part: 0, values: PARAMS.map(|p| p.2), dirty: false, inspection: Value::Null, error: None, step_name: String::new() }
+    }
+}
+impl State {
+    fn sync(&mut self, app: &mut SolveApp) {
+        if app.file_picker_busy() || app.file_load.busy() {
+            return;
+        }
+        match app.run("skm.scene.inspect", json!({})) {
+            Ok(value) => {
+                if !self.dirty {
+                    for (index, (key, _, default, _, _)) in PARAMS.iter().enumerate() {
+                        if let Some(slot) = self.values.get_mut(index) {
+                            *slot = value.get("parameters").and_then(|p| p.get(*key)).and_then(Value::as_f64).unwrap_or(*default);
+                        }
+                    }
+                }
+                self.inspection = value;
+            }
+            Err(error) => self.error = Some(error.to_string()),
+        }
+    }
+    fn apply(&mut self, app: &mut SolveApp) {
+        let mut parameters = serde_json::Map::new();
+        for ((key, _, _, _, _), value) in PARAMS.iter().zip(self.values.iter()) {
+            if !value.is_finite() {
+                self.error = Some(tr("skm.workspace.text_021").into());
+                return;
+            }
+            parameters.insert((*key).into(), json!(value));
+        }
+        match app.run("skm.scene.configure", Value::Object(parameters)) {
+            Ok(_) => {
+                self.dirty = false;
+                self.error = None;
+                self.sync(app);
+            }
+            Err(error) => self.error = Some(error.to_string()),
+        }
+    }
+    fn field(&mut self, ui: &mut Ui, index: usize) {
+        if let Some((_, label, _, low, high)) = PARAMS.get(index)
+            && let Some(value) = self.values.get_mut(index)
+        {
+            let label = ui.label(tr(label));
+            let response = ui.add(egui::DragValue::new(value).range(*low..=*high).speed(0.05).max_decimals(2)).labelled_by(label.id);
+            crate::scenario::publish_target(&format!("skm:parameter:{index}"), response.rect);
+            self.dirty |= response.changed();
+            ui.add_space(8.0);
+        }
+    }
+}
+
+fn button(ui: &mut Ui, label: &str, handle: &str) -> bool {
+    enabled_button(ui, label, handle, true)
+}
+fn enabled_button(ui: &mut Ui, label: &str, handle: &str, enabled: bool) -> bool {
+    let response = ui.add_enabled(enabled, egui::Button::new(label));
+    crate::scenario::publish_target(handle, response.rect);
+    response.clicked()
+}
+fn tr(key: &str) -> &str {
+    crate::i18n::tr(key)
+}
+fn note(ui: &mut Ui, text: &str) {
+    ui.label(RichText::new(text).small().color(Tokens::get().text_dim));
+}
+
+impl SolveApp {
+    /// Select the dedicated SKM shell. Creating the reference scene is explicit and
+    /// refused by the engine when an existing design would be overwritten.
+    pub fn enable_skm_workspace(&mut self) {
+        self.skm_workspace = Some(State::default());
+        self.home.open = false;
+        self.preferences.language = "es".into();
+        self.ui.layout = crate::shell::LayoutMode::Docked;
+        self.ui.show_browser = false;
+        self.ui.show_timeline = false;
+        self.lift_plan = None;
+        if self.file_picker_busy() || self.file_load.busy() {
+            return;
+        }
+        let existing = self.run("skm.scene.inspect", json!({})).ok().and_then(|v| v.get("exists").and_then(Value::as_bool)).unwrap_or(false);
+        if !existing {
+            if let Err(error) = self.run("skm.scene.create", json!({})) {
+                if let Some(state) = self.skm_workspace.as_mut() {
+                    state.error = Some(error.to_string());
+                }
+            } else {
+                self.fit_view();
+            }
+        }
+    }
+}
+
+/// Invalidate drafts on replacement/tab switching, including a command run while
+/// show temporarily owns State. An old draft must never configure another design.
+pub(crate) fn reset_document(app: &mut SolveApp) {
+    app.skm_document_epoch = app.skm_document_epoch.wrapping_add(1);
+    if app.skm_workspace.is_some() {
+        app.skm_workspace = Some(State::default());
+    }
+}
+
+pub(crate) fn show(app: &mut SolveApp, ui: &mut Ui) {
+    let Some(mut state) = app.skm_workspace.take() else { return };
+    let document_epoch = app.skm_document_epoch;
+    app.home.open = false;
+    app.ui.layout = crate::shell::LayoutMode::Docked;
+    app.ui.show_browser = false;
+    app.ui.show_timeline = false;
+    app.ui.layout.publish(ui.ctx());
+    app.shell.cards.clear();
+    app.shell.panels.clear();
+    app.shell.browser = None;
+    app.shell.history = None;
+    state.sync(app);
+    let geometry_current = state.inspection.get("exists").and_then(Value::as_bool) == Some(true)
+        && state.inspection.get("managed_geometry_matches_parameters").and_then(Value::as_bool) == Some(true);
+    let tokens = Tokens::get();
+    Container::new(ui.ctx(), Surface::ApplicationBar)
+        .edge("skm_header", Edge::Top)
+        .exact_size(44.0)
+        .frame(Container::new(ui.ctx(), Surface::ApplicationBar).edge_frame(tokens.app_bar))
+        .show(ui, |ui| {
+            let rect = ui.max_rect();
+            if app.custom_titlebar {
+                crate::titlebar::drag_area(ui, rect);
+            }
+            ui.horizontal(|ui| {
+                ui.label(RichText::new(tr("skm.workspace.text_022")).strong().size(16.0));
+                ui.separator();
+                ui.label(&app.session.doc.name);
+                if button(ui, tr("skm.workspace.text_023"), "skm:open") {
+                    crate::toolbar::FileAction::Open.run(app);
+                }
+                if button(ui, tr("skm.workspace.text_024"), "skm:save") {
+                    crate::toolbar::FileAction::Save.run(app);
+                }
+            });
+            if app.custom_titlebar {
+                crate::titlebar::caption_buttons(app, ui, rect);
+            }
+        });
+    Container::new(ui.ctx(), Surface::Chrome)
+        .edge("skm_workflow", Edge::Top)
+        .exact_size(76.0)
+        .frame(Container::new(ui.ctx(), Surface::Chrome).edge_frame(tokens.toolbar))
+        .show(ui, |ui| {
+            ui.horizontal(|ui| {
+                for (index, label) in AREAS.iter().enumerate() {
+                    let response = ui.selectable_label(state.area == index, format!("{}  {}", index + 1, tr(label)));
+                    crate::scenario::publish_target(&format!("skm:area:{index}"), response.rect);
+                    if response.clicked() {
+                        state.area = index;
+                    }
+                }
+            });
+            ui.separator();
+            ui.horizontal(|ui| {
+                if button(ui, tr("skm.workspace.text_025"), "skm:fit") {
+                    app.fit_view();
+                }
+                if button(ui, tr("skm.workspace.text_026"), "skm:iso") {
+                    app.start("view.isometric");
+                }
+                if button(ui, tr("skm.workspace.text_027"), "skm:top") {
+                    app.start("view.top");
+                }
+                if state.dirty {
+                    ui.colored_label(tokens.form_error, tr("skm.workspace.text_028"));
+                } else {
+                    note(ui, tr("skm.workspace.text_029"));
+                }
+            });
+        });
+    Container::new(ui.ctx(), Surface::Chrome)
+        .edge("skm_safety", Edge::Bottom)
+        .exact_size(42.0)
+        .frame(Container::new(ui.ctx(), Surface::Chrome).edge_frame(tokens.panel))
+        .show(ui, |ui| {
+            ui.horizontal_wrapped(|ui| {
+                ui.colored_label(tokens.form_error, RichText::new(tr("skm.workspace.text_030")).strong());
+                ui.label(tr("skm.workspace.text_031"));
+            });
+        });
+    let panel_width = if ui.available_width() < 1100.0 { 220.0 } else { 268.0 };
+    Container::new(ui.ctx(), Surface::Panel)
+        .edge("skm_assembly", Edge::Left)
+        .exact_size(panel_width)
+        .frame(Container::new(ui.ctx(), Surface::Panel).edge_frame(tokens.panel))
+        .show(ui, |ui| {
+            ui.heading(if state.area == 2 { tr("skm.workspace.text_032") } else { tr("skm.workspace.text_033") });
+            note(ui, tr("skm.workspace.text_034"));
+            ui.separator();
+            if button(ui, tr("skm.workspace.text_035"), "skm:crane") {
+                state.area = 1;
+            }
+            note(ui, tr("skm.workspace.text_036"));
+            ui.add_space(16.0);
+            for (index, name) in PARTS.iter().enumerate() {
+                let response =
+                    ui.add_sized([ui.available_width(), 50.0], egui::Button::new(tr(name)).selected(state.area == 2 && state.part == index));
+                crate::scenario::publish_target(&format!("skm:part:{index}"), response.rect);
+                crate::scenario::publish_target(&format!("skm:rig:{index}"), response.rect);
+                if response.clicked() {
+                    state.area = 2;
+                    state.part = index;
+                }
+                if index != 4 {
+                    note(ui, tr("skm.workspace.text_037"));
+                }
+            }
+            ui.separator();
+            note(ui, tr("skm.workspace.text_038"));
+        });
+    Container::new(ui.ctx(), Surface::Panel)
+        .edge("skm_inspector", Edge::Right)
+        .exact_size(panel_width + 24.0)
+        .frame(Container::new(ui.ctx(), Surface::Panel).edge_frame(tokens.panel))
+        .show(ui, |ui| {
+            egui::ScrollArea::vertical().show(ui, |ui| {
+                ui.heading(tr(AREAS.get(state.area).copied().unwrap_or("skm.workspace.text_000")));
+                ui.separator();
+                if !geometry_current {
+                    ui.colored_label(tokens.form_error, tr("skm.workspace.stale_geometry"));
+                    if let Some(warning) = state.inspection.get("geometry_warning").and_then(Value::as_str) {
+                        note(ui, warning);
+                    }
+                    ui.separator();
+                }
+                match state.area {
+                    0 => {
+                        ui.label(tr("skm.workspace.text_039"));
+                        note(ui, tr("skm.workspace.text_040"));
+                        ui.add_space(12.0);
+                        ui.label(tr("skm.workspace.text_041"));
+                        ui.label(tr("skm.workspace.text_042"));
+                        ui.label(tr("skm.workspace.text_043"));
+                        ui.label(tr("skm.workspace.text_044"));
+                        if state.inspection.get("exists").and_then(Value::as_bool) != Some(true) {
+                            ui.colored_label(tokens.form_error, tr("skm.workspace.text_045"));
+                            note(ui, tr("skm.workspace.text_046"));
+                        }
+                    }
+                    1 => {
+                        ui.label(RichText::new(tr("skm.workspace.text_047")).strong());
+                        note(ui, tr("skm.workspace.text_048"));
+                        for index in 0..4 {
+                            state.field(ui, index);
+                        }
+                        if let Some(radius) = state.inspection.get("working_radius_m").and_then(Value::as_f64) {
+                            ui.label(format!("{}: {radius:.2} m", tr("skm.workspace.radius")));
+                        }
+                        note(ui, tr("skm.workspace.text_049"));
+                    }
+                    2 => {
+                        ui.label(RichText::new(tr(PARTS.get(state.part).copied().unwrap_or("skm.workspace.text_050"))).strong());
+                        ui.add_space(10.0);
+                        match state.part {
+                            0 => state.field(ui, 3),
+                            1 => {
+                                state.field(ui, 5);
+                                note(ui, tr("skm.workspace.text_051"));
+                            }
+                            2 => {
+                                state.field(ui, 4);
+                                note(ui, tr("skm.workspace.text_052"));
+                            }
+                            3 => {
+                                state.field(ui, 6);
+                                note(ui, tr("skm.workspace.text_051"));
+                            }
+                            _ => {
+                                for index in 7..10 {
+                                    state.field(ui, index);
+                                }
+                                note(ui, tr("skm.workspace.text_053"));
+                            }
+                        }
+                    }
+                    3 => {
+                        let step_label = ui.label(tr("skm.workspace.text_054"));
+                        note(ui, tr("skm.workspace.text_055"));
+                        let response = ui.text_edit_singleline(&mut state.step_name).labelled_by(step_label.id);
+                        crate::scenario::publish_target("skm:step_name", response.rect);
+                        if enabled_button(ui, tr("skm.workspace.text_056"), "skm:capture", geometry_current && !state.dirty) {
+                            match app.run("skm.scene.capture", json!({"name": state.step_name})) {
+                                Ok(_) => {
+                                    state.error = None;
+                                    state.sync(app);
+                                }
+                                Err(error) => state.error = Some(error.to_string()),
+                            }
+                        }
+                        let steps = state.inspection.get("steps").and_then(Value::as_array).cloned().unwrap_or_default();
+                        for (index, step) in steps.into_iter().enumerate() {
+                            if let Some(name) = step.get("name").and_then(Value::as_str)
+                                && enabled_button(
+                                    ui,
+                                    &format!("{}: {name}", tr("skm.workspace.apply_step")),
+                                    &format!("skm:step:{index}"),
+                                    geometry_current && !state.dirty,
+                                )
+                            {
+                                match app.run("skm.scene.apply", json!({"name":name})) {
+                                    Ok(_) => {
+                                        state.dirty = false;
+                                        state.error = None;
+                                        state.sync(app);
+                                    }
+                                    Err(error) => state.error = Some(error.to_string()),
+                                }
+                            }
+                        }
+                    }
+                    4 => {
+                        ui.label(RichText::new(tr("skm.workspace.text_057")).strong().color(tokens.form_error));
+                        for label in [
+                            tr("skm.workspace.text_058"),
+                            tr("skm.workspace.text_059"),
+                            tr("skm.workspace.text_060"),
+                            tr("skm.workspace.text_061"),
+                            tr("skm.workspace.text_062"),
+                            tr("skm.workspace.text_063"),
+                        ] {
+                            ui.separator();
+                            ui.label(label);
+                            note(ui, tr("skm.workspace.text_064"));
+                        }
+                    }
+                    _ => {
+                        ui.label(tr("skm.workspace.text_065"));
+                        note(ui, tr("skm.workspace.text_066"));
+                        let report = format!(
+                            "{}\n{}\n{}\n{}",
+                            tr("skm.workspace.report_title"),
+                            app.session.doc.name,
+                            serde_json::to_string_pretty(&state.inspection).unwrap_or_default(),
+                            tr("skm.workspace.report_limit")
+                        );
+                        if button(ui, tr("skm.workspace.text_067"), "skm:report") {
+                            ui.ctx().copy_text(report.clone());
+                        }
+                        if button(ui, tr("skm.workspace.text_068"), "skm:report_save") {
+                            crate::toolbar::FileAction::Save.run(app);
+                        }
+                        ui.separator();
+                        ui.label(report);
+                        note(ui, tr("skm.workspace.text_069"));
+                    }
+                }
+                if matches!(state.area, 1 | 2) {
+                    ui.separator();
+                    if enabled_button(ui, tr("skm.workspace.text_070"), "skm:apply", geometry_current) {
+                        state.apply(app);
+                    }
+                    if button(ui, tr("skm.workspace.text_071"), "skm:discard") {
+                        state.dirty = false;
+                        state.error = None;
+                        state.sync(app);
+                    }
+                }
+                if let Some(error) = &state.error {
+                    ui.separator();
+                    ui.colored_label(tokens.form_error, error);
+                }
+            });
+        });
+    Container::new(ui.ctx(), Surface::Viewport)
+        .central()
+        .frame(Container::new(ui.ctx(), Surface::Viewport).edge_frame(egui::Color32::TRANSPARENT))
+        .show(ui, |ui| {
+            app.shell.content = Some(ui.max_rect());
+            crate::preview::update(app, ui.ctx());
+            crate::viewport::show(app, ui);
+        });
+    crate::scenario::publish_count("skm:active_area", state.area as f64);
+    app.resolve_fit(ui.ctx());
+    app.skm_workspace = Some(if app.skm_document_epoch == document_epoch { state } else { State::default() });
+}
