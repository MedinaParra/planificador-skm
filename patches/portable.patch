+//! Compile-time, app-only portable distribution policy and application-owned paths.
+//!
+//! The desktop initializes these before reading preferences or starting any service. There
+//! is no environment switch or preference that disables portable mode. This is filesystem
+//! placement, not an OS sandbox: files the user explicitly opens/saves retain their paths.
+
+use std::io::{Error, ErrorKind, Result, Write};
+use std::path::{Path, PathBuf};
+use std::sync::OnceLock;
+
+static ROOT: OnceLock<PathBuf> = OnceLock::new();
+const CHILDREN: &[&str] = &["settings", "recovery", "crashes", "temp", "plugins", "thumbnails"];
+
+/// Set by Cargo for the portable distribution, never by saved preferences or an environment variable.
+pub const fn enabled() -> bool {
+    cfg!(feature = "portable")
+}
+
+/// The already-validated root. None before initialization; callers must not fall back to AppData.
+pub fn root() -> Option<PathBuf> {
+    ROOT.get().cloned()
+}
+
+/// A known application-owned child, never an arbitrary or user-supplied path.
+pub fn directory(name: &str) -> Option<PathBuf> {
+    CHILDREN.contains(&name).then(|| ROOT.get().map(|p| p.join(name))).flatten()
+}
+
+/// Infallible legacy temp APIs get an invalid filename until initialized, not a user-profile fallback.
+/// A NUL is rejected by the filesystem APIs on all supported native systems.
+pub fn temp_dir() -> PathBuf {
+    directory("temp").unwrap_or_else(|| PathBuf::from("\0SolidCraft portable storage is not initialized"))
+}
+
+/// Initialize exactly once, before preferences, recovery, crashes, network or plugin discovery.
+/// A failure is returned to the host; it must stop instead of running with non-portable paths.
+pub fn initialize(executable: &Path) -> Result<()> {
+    if !enabled() {
+        return Err(Error::other("this is not a portable SolidCraft build"));
+    }
+    if ROOT.get().is_some() {
+        return Err(Error::new(ErrorKind::AlreadyExists, "portable storage is already initialized"));
+    }
+    ROOT.set(prepare(executable)?).map_err(|_| Error::new(ErrorKind::AlreadyExists, "portable storage was initialized concurrently"))
+}
+
+fn prepare(executable: &Path) -> Result<PathBuf> {
+    if !executable.is_absolute() || !executable.is_file() {
+        return Err(Error::new(ErrorKind::InvalidInput, "portable executable must be an existing absolute file"));
+    }
+    let parent = executable.parent().ok_or_else(|| Error::new(ErrorKind::InvalidInput, "portable executable has no parent"))?;
+    let parent = std::fs::canonicalize(parent)?;
+    let root = parent.join("data");
+    make_directory(&root)?;
+    if std::fs::canonicalize(&root)?.parent() != Some(parent.as_path()) {
+        return Err(Error::new(ErrorKind::InvalidInput, "portable data directory resolves outside the executable folder"));
+    }
+    for child in CHILDREN {
+        make_directory(&root.join(child))?;
+    }
+    Ok(root)
+}
+
+fn make_directory(path: &Path) -> Result<()> {
+    match std::fs::symlink_metadata(path) {
+        Ok(meta) if is_redirect(&meta) || !meta.is_dir() => {
+            return Err(Error::new(
+                ErrorKind::InvalidInput,
+                format!("portable directory must be a real directory, not a link or file: {}", path.display()),
+            ));
+        }
+        Ok(_) => {}
+        Err(e) if e.kind() == ErrorKind::NotFound => std::fs::create_dir(path)?,
+        Err(e) => return Err(e),
+    }
+    // Never truncate a pre-existing probe or change permissions. A stale probe is a visible error.
+    let probe = path.join(format!(".solidcraft-write-check-{}", std::process::id()));
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(&probe)?;
+    let written = file.write_all(b"SolidCraft portable storage check\n");
+    drop(file);
+    let removed = std::fs::remove_file(probe);
+    written?;
+    removed
+}
+
+fn is_redirect(meta: &std::fs::Metadata) -> bool {
+    if meta.file_type().is_symlink() {
+        return true;
+    }
+    #[cfg(windows)]
+    {
+        use std::os::windows::fs::MetadataExt;
+        // Junctions and other reparse points may not report themselves as a symlink.
+        if meta.file_attributes() & 0x400 != 0 {
+            return true;
+        }
+    }
+    false
+}
+
