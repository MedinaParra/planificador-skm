@@ -0,0 +1,99 @@
+//! Portable-distribution policy: user preferences cannot enable integrations.
+
+use serde_json::json;
+use solidcraft_engine::Session;
+use solidcraft_ui_egui::{Services, SolveApp, agent_chat, ai_connect, update};
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+/// Each integration-test executable initializes its own portable storage before VFS helpers.
+/// This is not a production fallback: the real host still fails closed before initialization.
+fn initialize_portable_test_storage() {
+    if !solidcraft_engine::geom::portable::enabled() {
+        return;
+    }
+    static INIT: std::sync::OnceLock<Result<(), String>> = std::sync::OnceLock::new();
+    let result = INIT.get_or_init(|| {
+        let exe = std::env::current_exe().map_err(|e| e.to_string())?;
+        solidcraft_engine::geom::portable::initialize(&exe).map_err(|e| e.to_string())
+    });
+    assert!(result.is_ok(), "portable test storage: {result:?}");
+}
+
+#[test]
+fn portable_policy_defaults_and_saved_preferences_cannot_enable_integrations() {
+    initialize_portable_test_storage();
+    let mut app = SolveApp::new(Session::default(), Services::default());
+    assert!(!app.preferences.ai_features);
+    assert!(!app.preferences.agent_control);
+    assert!(!app.preferences.connect_ai_apps);
+    assert!(!app.preferences.check_updates);
+    app.load_prefs(
+        &json!({"preferences": {
+            "ai_features": true, "agent_control": true, "connect_ai_apps": true, "check_updates": true
+        }})
+        .to_string(),
+    );
+    assert!(!app.preferences.ai_features);
+    assert!(!app.preferences.agent_control);
+    assert!(!app.preferences.connect_ai_apps);
+    assert!(!app.preferences.check_updates);
+}
+
+#[test]
+fn portable_policy_host_services_are_removed_before_use() {
+    initialize_portable_test_storage();
+    let calls = std::sync::Arc::new(AtomicUsize::new(0));
+    let counted = calls.clone();
+    let mut services = Services::default();
+    services.http_get = Some(std::sync::Arc::new(move |_| {
+        counted.fetch_add(1, Ordering::Relaxed);
+        Err(update::FetchError::Failed("test callback must stay unused".into()))
+    }));
+    let app = SolveApp::new(Session::default(), services);
+    assert!(app.services.http_get.is_none());
+    assert!(app.services.http_download.is_none());
+    assert!(app.services.agent_http.is_none());
+    assert!(app.services.secrets.is_none());
+    assert!(app.agent_chat.control_starter.is_none());
+    assert_eq!(calls.load(Ordering::Relaxed), 0);
+}
+
+#[test]
+fn portable_policy_direct_actions_do_not_override_distribution() {
+    initialize_portable_test_storage();
+    let mut app = SolveApp::new(Session::default(), Services::default());
+    let ctx = egui::Context::default();
+    app.preferences.ai_features = true;
+    app.preferences.connect_ai_apps = true;
+    assert!(!agent_chat::shown(&app));
+    assert!(agent_chat::control(&mut app, &ctx, &json!({"features": true})).is_err());
+    agent_chat::settings::open_add(&mut app);
+    assert!(app.agent_chat.settings.add.is_none());
+    ai_connect::begin(&mut app);
+    ai_connect::tick(&mut app);
+    app.enforce_portable_policy();
+    assert!(!app.preferences.ai_features);
+    assert!(!app.preferences.connect_ai_apps);
+}
+
+#[test]
+fn portable_policy_update_checks_and_installers_stay_disabled() {
+    initialize_portable_test_storage();
+    let mut app = SolveApp::new(Session::default(), Services::default());
+    let calls = std::sync::Arc::new(AtomicUsize::new(0));
+    let counted = calls.clone();
+    app.services.http_get = Some(std::sync::Arc::new(move |_| {
+        counted.fetch_add(1, Ordering::Relaxed);
+        Err(update::FetchError::Failed("test callback must stay unused".into()))
+    }));
+    app.preferences.check_updates = true;
+    let ctx = egui::Context::default();
+    assert!(!update::available(&mut app));
+    update::tick(&mut app, &ctx);
+    update::check_now(&mut app, &ctx);
+    update::start_install(&mut app, &ctx);
+    update::restart(&mut app);
+    assert!(update::install_method(&mut app).is_none());
+    assert!(update::take_launch(&mut app).is_none());
+    assert_eq!(calls.load(Ordering::Relaxed), 0);
+}
